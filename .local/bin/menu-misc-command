#!/usr/bin/env bash
SCRIPT_DIR="$HOME/.local/bin/menu-misc-commands"
export GUM_CHOOSE_CURSOR="> "
export GUM_CHOOSE_CURSOR_FOREGROUND="#FF75B7"
export GUM_CHOOSE_SELECTED_FOREGROUND="#00FFFF"
export GUM_CHOOSE_HEIGHT=15

choices=(
  "Move Workspace to Monitor"
  "Waybar Refresh"
)
scripts=(
  "move-workspace-to-monitor.sh"
  "waybar-refresh.sh"
)

clear
figlet -f Rectangles "Misc Commands"
chosen=$(printf "%s\n" "${choices[@]}" | gum choose)
[[ -z "$chosen" ]] && exit

for i in "${!choices[@]}"; do
  if [[ "${choices[$i]}" == "$chosen" ]]; then
    bash "$SCRIPT_DIR/${scripts[$i]}"
    break
  fi
done

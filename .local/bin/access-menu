#!/usr/bin/env bash
SCRIPT_DIR="$HOME/.access-menu"
export GUM_CHOOSE_CURSOR="> "
export GUM_CHOOSE_CURSOR_FOREGROUND="#FF75B7"
export GUM_CHOOSE_SELECTED_FOREGROUND="#00FFFF"
export GUM_CHOOSE_HEIGHT=15
while true; do
  clear
   figlet -f Rectangles Open Me
  chosen=$(ls "$SCRIPT_DIR" | gum choose)
  [[ -z "$chosen" ]] && break
  bash "$SCRIPT_DIR/$chosen"
done

{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "autoupdate": "notify",
  "instructions": ["AGENTS.md"],
  "references": {
    "filesystem-map": {
      "path": "~/.config/opencode/map",
      "description": "Generated orientation digest for the whole machine (~/.config/opencode/map/overview.md) — read this first when you need to know what exists somewhere, or where something lives"
    },
    "hyprland": {
      "path": "/usr/share/hypr/stubs",
      "description": "Hyprland Lua API stubs — use when writing or editing Hyprland Lua configuration (hl.meta.lua) for autocomplete, type info, and API reference"
    },
    "kitty": {
      "path": "~/.config/kitty",
      "description": "Kitty terminal emulator configuration — use when reading or editing kitty config files"
    },
    "waybar": {
      "path": "~/.config/waybar",
      "description": "Waybar status bar configuration — use when reading or editing waybar config, style, or module files"
    },
    "hyprland-config": {
      "path": "~/.config/hypr",
      "description": "Hyprland window manager configuration — use when reading or editing Lua config files (hyprland.lua, keybindings.lua, monitors.lua, etc.)"
    },
    "dotfiles": {
      "path": "~/.dotfiles",
      "description": "System dotfiles — use when reading or editing shell, git, or other dotfile configurations"
    },
    "src": {
      "path": "~/src",
      "description": "Local source projects (Hyprland tools, Waybar, ReGreet, etc.)"
    },
    "navi": {
      "path": "~/.local/share/navi/cheats",
      "description": "Navi cheatsheets — use when reading or writing navi .cheat files"
    }
  },
  "mcp": {
    "github": {
    "type": "remote",
    "url": "https://api.githubcopilot.com/mcp/",
    "enabled": true,
    "oauth": false,
    "headers": {
    "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
  }
}  },
  "permission": {
    "external_directory": {
      "~/.config/kitty/**": "allow",
      "~/.config/waybar/**": "allow",
      "~/.config/hypr/**": "allow",
      "~/.dotfiles/**": "allow",
      "~/src/**": "allow",
      "~/.local/bin/**": "allow",
      "~/.config/opencode/map/**": "allow",
      "~/.local/share/opencode/fsmap/**": "allow",
      "*": "ask"
    }
  }
}
